# ==============================================================================
# SUNGMI INDIA - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# For Railway: Copy these key-value pairs into the "Variables" tab of your service.
# For Local XAMPP: Defaults in admin/includes/db.php will automatically fall back
# to localhost/root/sungmi if these are not set.
# ==============================================================================

# Database Connection (Supplied automatically by Railway MySQL service)
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=sungmi

# Email / SMTP Configuration (Used by PHPMailer for enquiries and applications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Sungmi India"
